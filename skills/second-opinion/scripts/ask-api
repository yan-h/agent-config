#!/usr/bin/env python3
"""ask-api: one-shot design questions, second opinions and reviews on the
Claude API, billed to the API key's credits instead of a Claude subscription.

  ask-api "question" [-f FILE ...] [--diff RANGE]
  ask-api --review [--diff RANGE] [-f FILE ...] ["what to focus on"]
  git diff | ask-api "question about the piped text"

The answer goes to stdout; the model, cost estimate and actual cost go to
stderr, and every sent call is appended to $ASK_API_STATE/log.jsonl.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import stat
import subprocess
import sys
import time
from pathlib import Path

VENV_PYTHON = Path.home() / ".local/share/ask-api/venv/bin/python"
STATE = Path(os.environ.get("ASK_API_STATE", Path.home() / ".local/state/ask-api"))
KEYCHAIN_SERVICE = "anthropic-api-key"
SCRIPT = Path(__file__).resolve()
GLOBAL_AGENTS = SCRIPT.parents[3] / "global" / "AGENTS.md"
LINES = ("fable", "opus", "sonnet", "haiku")
FALLBACK_LINES = ("fable", "opus", "sonnet")  # haiku has no server-side fallback
CATALOG_TTL = 24 * 3600

# USD per million tokens (line, input, output); newest row of each line last.
# A newer model in a line borrows that line's last row until it gets its own.
# Haiku 5.5 doubles past 100K input tokens; ignored here.
PRICES = {
    "claude-fable-5-1": ("fable", 10.00, 50.00),
    "claude-opus-5-5": ("opus", 4.00, 20.00),
    "claude-sonnet-5-5": ("sonnet", 2.00, 10.00),
    "claude-haiku-5-5": ("haiku", 0.10, 0.50),
}

DESIGN_PROMPT = """\
You are giving a second opinion to a software engineer and the coding agent \
they work with. Answer the question about the material below. Give a \
recommendation rather than a survey, explain the tradeoffs that decide it, \
and say plainly where you are unsure. You see only the files, diff and text \
included here, not the whole repository: when the answer depends on code you \
were not shown, say which code and how it could change your answer. Refer to \
code as path:line where you can."""

REVIEW_PROMPT = """\
You are reviewing a change for a software engineer and the coding agent they \
work with. Find defects that would cause wrong behaviour, crashes, lost data \
or real performance problems, and judge whether the design is sound. You see \
only the diff and files included here, not the whole repository.

Rank findings most severe first. For each give path:line, the defect in one \
sentence, a concrete failure scenario (the inputs or state, then what goes \
wrong) and your confidence. Leave out style and formatting. When confirming a \
finding would need code you were not shown, say what you would check. End \
with a short assessment of the approach: whether it is sound, and any simpler \
or more maintainable alternative worth its cost. If you find no defects, say so."""


def note(message: str) -> None:
    print(f"ask-api: {message}", file=sys.stderr)


def fail(message: str, code: int = 1) -> None:
    note(message)
    sys.exit(code)


# --- model and price resolution (pure, tested) -----------------------------


def newest_in_line(models: list[dict], line: str) -> str | None:
    """The newest active model the catalog places in `line`."""
    active = [
        m for m in models if m.get("line") == line and m.get("lifecycle") == "active"
    ]
    return max(active, key=lambda m: m["created_at"])["id"] if active else None


def line_of(models: list[dict], model_id: str) -> str | None:
    for m in models:
        if m["id"] == model_id:
            return m.get("line")
    return PRICES.get(model_id, (None,))[0]


def price_for(model_id: str, line: str | None) -> tuple[float, float, str | None] | None:
    """(input, output, assumed_from) per million tokens, or None when unknown."""
    if model_id in PRICES:
        _, inp, out = PRICES[model_id]
        return inp, out, None
    known = [k for k, row in PRICES.items() if line is not None and row[0] == line]
    if not known:
        return None
    _, inp, out = PRICES[known[-1]]
    return inp, out, known[-1]


def guard(
    price: tuple[float, float, str | None] | None,
    input_tokens: int,
    max_tokens: int,
    limit: float,
    confirmed: bool,
) -> tuple[float | None, str | None]:
    """(worst-case cost, refusal reason or None)."""
    if price is None:
        reason = None if confirmed else "no price is known for this model; pass --yes to send anyway"
        return None, reason
    worst = (input_tokens * price[0] + max_tokens * price[1]) / 1e6
    if worst > limit and not confirmed:
        return worst, (
            f"worst case ${worst:.2f} is over the ${limit:.2f} limit; narrow the "
            "context, lower --max-tokens, or pass --yes"
        )
    return worst, None


# --- context ---------------------------------------------------------------


def git(*args: str) -> str:
    result = subprocess.run(["git", *args], capture_output=True, text=True)
    if result.returncode:
        fail(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout


def repo_root() -> Path | None:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    )
    return Path(result.stdout.strip()) if result.returncode == 0 else None


def shown_path(path: Path, root: Path | None) -> str:
    path = path.resolve()
    if root is not None and path.is_relative_to(root.resolve()):
        return str(path.relative_to(root.resolve()))
    return str(path)


def read_text(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None


def piped_stdin() -> str | None:
    """Text piped or redirected into stdin; a terminal or /dev/null is not read."""
    mode = os.fstat(0).st_mode
    if stat.S_ISFIFO(mode) or stat.S_ISREG(mode):
        text = sys.stdin.read()
        return text if text.strip() else None
    return None


def review_base() -> str:
    for ref in ("origin/main", "main"):
        result = subprocess.run(
            ["git", "merge-base", ref, "HEAD"], capture_output=True, text=True
        )
        if result.returncode == 0:
            return result.stdout.strip()
    fail("no origin/main or main to review against; pass --diff RANGE")


def build_prompt(args: argparse.Namespace) -> tuple[str, str, list[str]]:
    """(system, user message, labels of what was included)."""
    root = repo_root()
    included: list[str] = []

    system = [REVIEW_PROMPT if args.review else DESIGN_PROMPT]
    if not args.no_instructions:
        owner = read_text(GLOBAL_AGENTS)
        if owner:
            system.append(f"<owner_preferences>\n{owner}</owner_preferences>")
            included.append("owner preferences")
        for name in ("AGENTS.md", "CLAUDE.md"):
            contract = read_text(root / name) if root else None
            if contract:
                system.append(f'<repository_contract file="{name}">\n{contract}</repository_contract>')
                included.append(name)
                break

    parts: list[str] = []
    diff_args = args.diff.split() if args.diff else ([review_base()] if args.review else None)
    files = [Path(f) for f in args.file]
    if diff_args:
        diff = git("diff", *diff_args)
        if not diff.strip():
            fail(f"git diff {' '.join(diff_args)} is empty")
        parts.append(f'<diff args="{" ".join(diff_args)}">\n{diff}</diff>')
        included.append(f"diff {' '.join(diff_args)}")
        if args.review and root:
            changed = git("diff", "--name-only", "--diff-filter=d", *diff_args).split()
            files = [root / c for c in changed] + files
    seen: set[Path] = set()
    for path in files:
        if path.resolve() in seen:
            continue
        seen.add(path.resolve())
        text = read_text(path)
        if text is None:
            if path in [Path(f) for f in args.file]:
                fail(f"cannot read {path} as UTF-8 text")
            continue  # binary or vanished file named by the diff
        parts.append(f'<file path="{shown_path(path, root)}">\n{text}</file>')
        included.append(shown_path(path, root))
    stdin = piped_stdin()
    if stdin:
        parts.append(f"<piped_input>\n{stdin}</piped_input>")
        included.append("piped input")

    question = args.question or ("Review this change." if args.review else None)
    if not question:
        fail("nothing to ask: give a question, or --review")
    parts.append(question)
    return "\n\n".join(system), "\n\n".join(parts), included


# --- API -------------------------------------------------------------------


def api_key() -> str:
    key = os.environ.get("ANTHROPIC_API_KEY")
    if key:
        return key
    result = subprocess.run(
        ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-w"],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip()
    fail(
        "no API key: set ANTHROPIC_API_KEY, or store one with\n"
        f'  security add-generic-password -a "$USER" -s {KEYCHAIN_SERVICE} -w'
    )


def catalog(client, anthropic) -> list[dict]:
    """The model list, cached for a day; a stale cache beats no answer."""
    path = STATE / "models.json"
    try:
        cached = json.loads(path.read_text())
        if time.time() - cached["fetched"] < CATALOG_TTL:
            return cached["models"]
    except (OSError, ValueError, KeyError):
        cached = None
    try:
        models = [
            {
                "id": m.id,
                "line": m.line,
                "lifecycle": m.lifecycle,
                "created_at": m.created_at.isoformat(),
            }
            for m in client.models.list()
        ]
    except anthropic.APIError as error:
        if cached:
            note(f"model list unavailable ({error}); using the cached one")
            return cached["models"]
        raise
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps({"fetched": time.time(), "models": models}))
    tmp.replace(path)
    return models


def resolve(name: str, models: list[dict]) -> str:
    if name not in LINES:
        return name
    newest = newest_in_line(models, name)
    if newest is None:
        known = [k for k, row in PRICES.items() if row[0] == name]
        note(f"the model list names no active {name} model; using {known[-1]}")
        return known[-1]
    return newest


def log(entry: dict) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "log.jsonl").open("a") as f:
        f.write(json.dumps(entry) + "\n")


def ensure_sdk():
    try:
        import anthropic
    except ImportError:
        if VENV_PYTHON.exists() and Path(sys.executable) != VENV_PYTHON:
            os.execv(VENV_PYTHON, [str(VENV_PYTHON), str(SCRIPT), *sys.argv[1:]])
        fail(
            "the anthropic SDK is missing; install it with\n"
            f"  python3 -m venv {VENV_PYTHON.parents[1]} && "
            f"{VENV_PYTHON.parent}/pip install anthropic"
        )
    return anthropic


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="ask-api", description=__doc__.split("\n\n")[0])
    p.add_argument("question", nargs="?", help="the question, or what a review should focus on")
    p.add_argument("-f", "--file", action="append", default=[], help="include a file (repeatable)")
    p.add_argument("--diff", metavar="ARGS", help='git diff arguments, e.g. "origin/main...HEAD"')
    p.add_argument("--review", action="store_true", help="review a change; diffs against the merge base with main unless --diff is given")
    p.add_argument("-m", "--model", default="fable", help="fable, opus, sonnet, haiku (newest of the line) or a full model ID; default fable")
    p.add_argument("--effort", default="high", choices=["low", "medium", "high", "xhigh", "max"])
    p.add_argument("--max-tokens", type=int, default=32000)
    p.add_argument("--max-cost", type=float, default=float(os.environ.get("ASK_API_MAX_COST", "3")), help="refuse when the worst case exceeds this many USD (default 3, or $ASK_API_MAX_COST)")
    p.add_argument("-y", "--yes", action="store_true", help="send even over the cost limit or with no known price")
    p.add_argument("--dry-run", action="store_true", help="estimate and list the context, then stop")
    p.add_argument("--no-instructions", action="store_true", help="leave out AGENTS.md and the owner preferences")
    return p.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    anthropic = ensure_sdk()
    os.environ.pop("ANTHROPIC_AUTH_TOKEN", None)  # bill the key, never an OAuth token
    client = anthropic.Anthropic(api_key=api_key())

    system, user, included = build_prompt(args)
    models = catalog(client, anthropic)
    model = resolve(args.model, models)
    line = line_of(models, model)
    price = price_for(model, line)
    messages = [{"role": "user", "content": user}]

    try:
        input_tokens = client.messages.count_tokens(
            model=model, system=system, messages=messages
        ).input_tokens
    except anthropic.NotFoundError:
        fail(f"model {model} was not found (retired?); --model fable or opus picks the newest")
    worst, refusal = guard(price, input_tokens, args.max_tokens, args.max_cost, args.yes)

    label = model if args.model == model else f"{args.model} → {model}"
    assumed = f" (price assumed from {price[2]}; add a PRICES row in {SCRIPT})" if price and price[2] else ""
    cost_text = f"≤ ${worst:.2f}" if worst is not None else "unknown cost"
    note(f"{label} · {input_tokens:,} input tokens · {cost_text}{assumed}")
    note(f"context: {', '.join(included) or 'question only'}")
    if refusal:
        fail(refusal, 2)
    if args.dry_run:
        return 0

    request = dict(
        model=model,
        max_tokens=args.max_tokens,
        system=system,
        messages=messages,
        output_config={"effort": args.effort},
    )
    if line in FALLBACK_LINES:
        request |= dict(betas=["server-side-fallback-2026-07-01"], fallbacks="default")
    started = time.time()
    try:
        with client.beta.messages.stream(**request) as stream:
            for text in stream.text_stream:
                sys.stdout.write(text)
                sys.stdout.flush()
            message = stream.get_final_message()
    except anthropic.NotFoundError:
        fail(f"model {model} was not found (retired?); --model fable or opus picks the newest")
    print(flush=True)

    usage = message.usage
    cache_write = usage.cache_creation_input_tokens or 0
    cache_read = usage.cache_read_input_tokens or 0
    cost = None
    if price:
        billed_input = usage.input_tokens + 1.25 * cache_write + 0.1 * cache_read
        cost = (billed_input * price[0] + usage.output_tokens * price[1]) / 1e6
    served_by = message.model if message.model != model else None

    log(
        {
            "at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
            "repo": str(repo_root() or Path.cwd()),
            "mode": "review" if args.review else "question",
            "asked": args.model,
            "model": model,
            "served_by": served_by,
            "effort": args.effort,
            "input_tokens": usage.input_tokens,
            "cache_write_tokens": cache_write,
            "cache_read_tokens": cache_read,
            "output_tokens": usage.output_tokens,
            "cost_usd": None if cost is None else round(cost, 4),
            "price_assumed_from": price[2] if price else None,
            "stop_reason": message.stop_reason,
            "seconds": round(time.time() - started, 1),
            "question": (args.question or "")[:200],
        }
    )

    cost_text = f"${cost:.2f}" if cost is not None else "unknown cost"
    tail = f" · answered by {served_by} after a refusal, cost approximate" if served_by else ""
    note(f"{model} · {usage.input_tokens:,} in / {usage.output_tokens:,} out · {cost_text}{tail}")
    if message.stop_reason == "refusal":
        details = getattr(message, "stop_details", None)
        category = getattr(details, "category", None)
        fail(f"the model declined{f' ({category})' if category else ''}", 3)
    if message.stop_reason == "max_tokens":
        fail(f"the answer was cut off at --max-tokens {args.max_tokens}", 4)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
