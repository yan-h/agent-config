<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yan.claude-remote-control</string>

	<!-- launchd does not expand ~ or $HOME, so a shell resolves the linked script. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>exec "$HOME/.claude/remote-control-at-login.sh"</string>
	</array>

	<!-- Run at login, then every 5 minutes so a lost tmux server comes back. The Remote Control
	     servers live on in tmux, not under launchd; the rerun skips every window that exists. -->
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>

	<!-- The script exits once tmux is started; keep launchd from killing what it leaves behind. -->
	<key>AbandonProcessGroup</key>
	<true/>

	<!-- Without this launchd runs the job at background priority, and the tmux server and every
	     session under it inherit that: work spread over many cores ran about three times slower
	     (measured 2026-11-09). Takes effect for a tmux server started after the change. -->
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
