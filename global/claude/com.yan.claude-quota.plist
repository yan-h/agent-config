<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yan.claude-quota</string>

	<!-- launchd does not expand ~ or $HOME, so a shell resolves the linked script. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>exec "$HOME/.claude/quota-poll.sh"</string>
	</array>

	<!-- Every 5 minutes: fine enough to tie the 5-hour meter's moves to the sessions behind them.
	     Polls missed while the Mac sleeps are skipped, not made up. -->
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
